__pycache__/
*.py[cod]
.venv/
venv/
*.db
*.sqlite3
.env
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.DS_Store

# personal notes, not for the public repo. DEPLOY.md records this instance's account
# names and dashboard specifics; the shareable half of it lives in README.md.
SELF_CHECK.md
DEPLOY.md
*.egg-info/

# Frontend build artefacts. package-lock.json is NOT ignored: it is what makes
# `npm ci` reproducible, and a lockfile that only exists on one machine is no lockfile.
web/node_modules/
web/dist/

# Scratch directory used when staging the tree for an out-of-band build check.
.deploytmp/

# Data dumps. This repository is public, and an export of the live database contains
# real balances, addresses and account identifiers — the schema is the shareable part,
# the rows are not. Ignored by pattern rather than by name so the next export cannot be
# committed by being called something slightly different.
*.sql
import_to_neon.sql
life.db
