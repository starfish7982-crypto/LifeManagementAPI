# Copy to .env and fill in. Never commit .env.

# Signs access tokens. Anyone with this value can mint a token for any account.
# Generate with: openssl rand -hex 32
# The app refuses to start with this default once DATABASE_URL is not local SQLite.
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=720

DATABASE_URL=sqlite:///./life.db

# Comma-separated origins allowed to call this API from a browser. Never "*": the
# frontend sends an Authorization header, and a wildcard would let any site drive it.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Whether POST /auth/register will create an account. Defaults to false, including
# when this variable is absent, so a deployment nobody configured cannot be signed up
# to by strangers. Set it to true to create your first account, then set it back.
ALLOW_REGISTRATION=true

# Telegram (optional). Leave blank to disable push notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Calendar (optional). Secret iCal URL from Calendar settings.
GOOGLE_CALENDAR_ICAL_URL=
CALENDAR_CACHE_TTL_SECONDS=900
